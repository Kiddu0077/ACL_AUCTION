# Supabase — get these from your project at https://supabase.com/dashboard
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, never expose to the client.
# Used by admin server actions/route handlers that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Tournament branding is centralized in lib/tournament.ts.
